# 统一行尾：仓库内一律 LF，避免 Windows 作者 + Linux 使用者之间的 CRLF 事故
# （.bat 例外，cmd.exe 需要 CRLF）
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.bat   text eol=crlf

# 二进制（若将来加入图片/权重索引等，避免被当文本处理）
*.png   binary
*.jpg   binary
*.gguf  binary
*.safetensors binary
*.so    binary
